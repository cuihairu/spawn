FROM node:24-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_USER_SERVICE_URL=http://localhost:8888
ARG VITE_GAME_SERVICE_URL=http://localhost:8890
ARG VITE_CONTENT_SERVICE_URL=http://localhost:8891
ARG VITE_COMMUNITY_SERVICE_URL=http://localhost:8892
ARG VITE_API_GATEWAY_URL=
ENV VITE_USER_SERVICE_URL=${VITE_USER_SERVICE_URL}
ENV VITE_GAME_SERVICE_URL=${VITE_GAME_SERVICE_URL}
ENV VITE_CONTENT_SERVICE_URL=${VITE_CONTENT_SERVICE_URL}
ENV VITE_COMMUNITY_SERVICE_URL=${VITE_COMMUNITY_SERVICE_URL}
ENV VITE_API_GATEWAY_URL=${VITE_API_GATEWAY_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
