syntax = "v1"

type LoginRequest {
	Username string `json:"username"`
	Password string `json:"password"`
}

type LoginResponse {
	Token    string `json:"token"`
	UserInfo any    `json:"user_info"`
}

type FeaturedRequest {
	Limit int64 `form:"limit,default=6"`
}

type FeaturedResponse {
	Games []any `json:"games"`
}

type RecommendationResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data"`
}

type RecommendationRequest {
	Id    int64  `path:"id"`
	Limit int64  `form:"limit,optional"`
	Genres string `form:"genres,optional"`
}

type HomeFeedRequest {
	Limit int64 `form:"limit,optional"`
}

// HomeFeed 系列是 BFF 聚合端点（GET /home/feed）的裁剪响应口径：
// 每组仅保留列表展示所需字段，正文/图片等大字段不下发（正文仅截断出摘要）。

type HomeFeedGame {
	Id         string   `json:"id"`
	Title      string   `json:"title"`
	CoverImage string   `json:"cover_image"`
	Score      float64  `json:"score"`
	Genres     []string `json:"genres"`
	Platforms  []string `json:"platforms"`
}

type HomeFeedPost {
	Id           int64  `json:"id"`
	TopicId      int64  `json:"topic_id"`
	AuthorId     int64  `json:"author_id"`
	AuthorName   string `json:"author_name"`
	Title        string `json:"title"`
	Summary      string `json:"summary"`
	LikeCount    int64  `json:"like_count"`
	CommentCount int64  `json:"comment_count"`
	CreatedAt    string `json:"created_at"`
}

type HomeFeedTopic {
	Id            int64  `json:"id"`
	Name          string `json:"name"`
	PostCount     int64  `json:"post_count"`
	FollowerCount int64  `json:"follower_count"`
	IsOfficial    bool   `json:"is_official"`
}

type HomeFeedGuide {
	Id         int64  `json:"id"`
	GameId     string `json:"game_id"`
	GameTitle  string `json:"game_title"`
	Title      string `json:"title"`
	Summary    string `json:"summary"`
	AuthorName string `json:"author_name"`
	Likes      int64  `json:"likes"`
	Views      int64  `json:"views"`
	CreatedAt  string `json:"created_at"`
}

type HomeFeedResponse {
	FeaturedGames []HomeFeedGame  `json:"featured_games"`
	HotPosts      []HomeFeedPost  `json:"hot_posts"`
	Topics        []HomeFeedTopic `json:"topics"`
	Guides        []HomeFeedGuide `json:"guides"`
	Degraded      []string        `json:"degraded"`
}

type UploadResponse {
	Url string `json:"url"`
}

service api-gateway {
	@handler LoginHandler
	post /auth/login (LoginRequest) returns (LoginResponse)

	@handler FeaturedGamesHandler
	get /games/featured (FeaturedRequest) returns (FeaturedResponse)

	@handler UserRecommendationsHandler
	get /users/:id/recommendations (RecommendationRequest) returns (RecommendationResponse)

	@handler ShareLinkHandler
	get /s/p/:id

	@handler HomeFeedHandler
	get /home/feed (HomeFeedRequest) returns (HomeFeedResponse)

	// 统一上传入口：multipart form 字段 file，JWT 之后落本地盘（方案 A）。
	@handler UploadHandler
	post /upload returns (UploadResponse)

	// 已上传图片的静态托管不进本 API 声明（非 JSON 端点），
	// 在 internal/handler/routes.go 注册 GET /uploads/:file。
}
