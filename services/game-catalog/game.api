syntax = "v1"

info(
	title: "Game Catalog API"
	desc: "游戏库、榜单、推荐服务"
)

type Game {
	Id string `json:"id"`
	Title string `json:"title"`
	Description string `json:"description"`
	Genres []string `json:"genres"`
	Platforms []string `json:"platforms"`
	ReleaseDate string `json:"release_date"`
	Developer string `json:"developer"`
	Publisher string `json:"publisher"`
	Tags []string `json:"tags"`
	Score float64 `json:"score"`
	TrendingScore int `json:"trending_score"`
	CoverImage string `json:"cover_image"`
	Screenshots []string `json:"screenshots"`
	VideoUrl string `json:"video_url"`
	Changelog string `json:"changelog"`
	DeveloperWebsite string `json:"developer_website"`
	StoreLink string `json:"store_link"`
	DownloadUrl string `json:"download_url"`
	PlayUrl string `json:"play_url"`
	Status string `json:"status"`
	ReviewReason string `json:"review_reason"`
}

type ListGamesRequest {
	Keyword string `form:"keyword,optional"`
	Genre string `form:"genre,optional"`
	Platform string `form:"platform,optional"`
	Tag string `form:"tag,optional"`
	Limit int64 `form:"limit,default=20"`
	Offset int64 `form:"offset,default=0"`
	Sort string `form:"sort,default=popularity"`
}

type ListGamesResponse {
	Games []Game `json:"games"`
	Total int `json:"total"`
	Limit int64 `json:"limit"`
	Offset int64 `json:"offset"`
}

type FeaturedRequest {
	Limit int64 `form:"limit,default=6"`
}

type FeaturedResponse {
	Games []Game `json:"games"`
}

type GetGameRequest {
	Id string `path:"id"`
}

type CreateGameRequest {
	Title string `json:"title"`
	Description string `json:"description"`
	Genres []string `json:"genres"`
	Platforms []string `json:"platforms"`
	ReleaseDate string `json:"release_date"`
	Developer string `json:"developer"`
	Publisher string `json:"publisher"`
	Tags []string `json:"tags"`
	Score float64 `json:"score"`
	CoverImage string `json:"cover_image"`
	Screenshots []string `json:"screenshots,optional"`
	VideoUrl string `json:"video_url,optional"`
	Changelog string `json:"changelog,optional"`
	DeveloperWebsite string `json:"developer_website,optional"`
	StoreLink string `json:"store_link,optional"`
	DownloadUrl string `json:"download_url,optional"`
	PlayUrl string `json:"play_url,optional"`
}

type UpdateGameTagsRequest {
	Id string `path:"id"`
	Tags []string `json:"tags"`
}

type RecommendationsRequest {
	UserId string `form:"userId,optional"`
	Genres string `form:"genres,optional"`
	Limit int64 `form:"limit,default=5"`
}

type RecommendationsResponse {
	Games []Game `json:"games"`
}

// ==================== GP-103 运营后台 ====================

type Partner {
	Id int64 `json:"id"`
	Name string `json:"name"`
	ContactEmail string `json:"contact_email"`
	Status string `json:"status"`
	CreatedAt string `json:"created_at"`
}

type GameOwnership {
	GameId string `json:"game_id"`
	PartnerId int64 `json:"partner_id"`
	GrantedBy int64 `json:"granted_by"`
	GrantedAt string `json:"granted_at"`
	Status string `json:"status"`
}

type GameReview {
	Id int64 `json:"id"`
	GameId string `json:"game_id"`
	VersionId string `json:"version_id"`
	SubmittedBy int64 `json:"submitted_by"`
	SubmittedAt string `json:"submitted_at"`
	Status string `json:"status"`
	ReviewerId int64 `json:"reviewer_id"`
	ReviewReason string `json:"review_reason"`
	ReviewedAt string `json:"reviewed_at"`
}

type GameVersion {
	Id string `json:"id"`
	GameId string `json:"game_id"`
	Version string `json:"version"`
	Changelog string `json:"changelog"`
	PackageName string `json:"package_name"`
	VersionCode int64 `json:"version_code"`
	SignFingerprint string `json:"sign_fingerprint"`
	SizeBytes int64 `json:"size_bytes"`
	Hash string `json:"hash"`
	StorageUrl string `json:"storage_url"`
	Status string `json:"status"`
	ReviewReason string `json:"review_reason"`
	CreatedAt string `json:"created_at"`
	// GP-105：包体托管在平台（storage_url 为 package://）时 true，可走受控下载
	Downloadable bool `json:"downloadable"`
}

type AuditLog {
	Id int64 `json:"id"`
	ActorId int64 `json:"actor_id"`
	ActorRole string `json:"actor_role"`
	Action string `json:"action"`
	ResourceType string `json:"resource_type"`
	ResourceId string `json:"resource_id"`
	BeforeJson string `json:"before_json"`
	AfterJson string `json:"after_json"`
	Ip string `json:"ip"`
	CreatedAt string `json:"created_at"`
}

type GrantRoleRequest {
	UserId int64 `json:"user_id"`
	Role string `json:"role"`
	PartnerId int64 `json:"partner_id,optional"`
}

type GrantRoleResponse {
	UserId int64 `json:"user_id"`
	Role string `json:"role"`
	PartnerId int64 `json:"partner_id"`
}

type CreatePartnerRequest {
	Name string `json:"name"`
	ContactEmail string `json:"contact_email,optional"`
}

type SetPartnerStatusRequest {
	Id int64 `path:"id"`
	Status string `json:"status"`
}

type PartnerListResponse {
	Partners []Partner `json:"partners"`
}

type AssignOwnershipRequest {
	Id string `path:"id"`
	PartnerId int64 `json:"partner_id"`
}

type ListReviewsRequest {
	Status string `form:"status,optional"`
	Limit int64 `form:"limit,default=20"`
	Offset int64 `form:"offset,default=0"`
}

type ReviewsListResponse {
	Reviews []GameReview `json:"reviews"`
	Total int `json:"total"`
}

type DecideReviewRequest {
	Id int64 `path:"id"`
	Decision string `json:"decision"`
	Reason string `json:"reason,optional"`
}

type PartnerSubmitRequest {
	Id string `path:"id"`
	VersionId string `json:"version_id,optional"`
}

type CreateVersionRequest {
	Id string `path:"id"`
	Version string `json:"version"`
	Changelog string `json:"changelog,optional"`
	PackageName string `json:"package_name,optional"`
	VersionCode int64 `json:"version_code,optional"`
	SignFingerprint string `json:"sign_fingerprint,optional"`
	SizeBytes int64 `json:"size_bytes,optional"`
	Hash string `json:"hash,optional"`
	StorageUrl string `json:"storage_url,optional"`
}

type VersionPathRequest {
	Id string `path:"id"`
	VersionId string `path:"versionId"`
}

type VersionListResponse {
	Versions []GameVersion `json:"versions"`
}

// LatestVersionResponse 游戏当前已发布版本（GP-105 公开视图；storage_url 置空）
type LatestVersionResponse {
	Version GameVersion `json:"version"`
}

type ListAuditRequest {
	ResourceType string `form:"resource_type,optional"`
	Limit int64 `form:"limit,default=50"`
	Offset int64 `form:"offset,default=0"`
}

type IdPathRequest {
	Id string `path:"id"`
}

type AuditListResponse {
	Logs []AuditLog `json:"logs"`
	Total int `json:"total"`
}

type MeResponse {
	UserId int64 `json:"user_id"`
	Username string `json:"username"`
	Role string `json:"role"`
	PartnerId int64 `json:"partner_id"`
}

service game-catalog {
	@handler ListGamesHandler
	get /games (ListGamesRequest) returns (ListGamesResponse)

	@handler GetGameDetailHandler
	get /games/:id (GetGameRequest) returns (Game)

	@handler CreateGameHandler
	post /games (CreateGameRequest)

	@handler UpdateGameTagsHandler
	patch /games/:id/tags (UpdateGameTagsRequest) returns (GameDetailResponse)

	@handler GetFeaturedGamesHandler
	get /games/featured (FeaturedRequest) returns (FeaturedResponse)

	@handler GetRecommendationsHandler
	get /games/recommendations (RecommendationsRequest) returns (RecommendationsResponse)

	// ---- GP-103：当前账号平台角色（任意已登录用户）----
	@handler MeHandler
	get /me returns (MeResponse)

	// ---- GP-103：运营后台（platform_admin / operator，角色守卫在服务端）----
	@handler GrantRoleHandler
	post /admin/roles (GrantRoleRequest) returns (GrantRoleResponse)

	@handler CreatePartnerHandler
	post /admin/partners (CreatePartnerRequest) returns (Partner)

	@handler ListPartnersHandler
	get /admin/partners returns (PartnerListResponse)

	@handler SetPartnerStatusHandler
	patch /admin/partners/:id (SetPartnerStatusRequest) returns (Partner)

	@handler AssignOwnershipHandler
	post /admin/games/:id/ownership (AssignOwnershipRequest) returns (GameOwnership)

	@handler ListReviewsHandler
	get /admin/reviews (ListReviewsRequest) returns (ReviewsListResponse)

	@handler DecideReviewHandler
	post /admin/reviews/:id/decision (DecideReviewRequest) returns (GameReview)

	@handler PublishGameHandler
	post /admin/games/:id/publish (IdPathRequest) returns (Game)

	@handler UnpublishGameHandler
	post /admin/games/:id/unpublish (IdPathRequest) returns (Game)

	@handler AdminListVersionsHandler
	get /admin/games/:id/versions (IdPathRequest) returns (VersionListResponse)

	@handler ListAuditLogsHandler
	get /admin/audit (ListAuditRequest) returns (AuditListResponse)

	// ---- GP-103：合作方自助（partner 角色，按归属限制）----
	@handler ListPartnerGamesHandler
	get /partner/games returns (ListGamesResponse)

	@handler PartnerSubmitHandler
	post /partner/games/:id/submit (PartnerSubmitRequest) returns (GameReview)

	@handler PartnerCreateVersionHandler
	post /partner/games/:id/versions (CreateVersionRequest) returns (GameVersion)

	@handler PartnerListVersionsHandler
	get /partner/games/:id/versions (IdPathRequest) returns (VersionListResponse)

	@handler PublishVersionHandler
	post /admin/games/:id/versions/:versionId/publish (VersionPathRequest) returns (GameVersion)

	@handler RevokeVersionHandler
	post /admin/games/:id/versions/:versionId/revoke (VersionPathRequest) returns (GameVersion)

	// ---- GP-105：包体托管与受控下载 ----
	// latest 公开元数据；download 登录后仅放行已发布+平台托管版本（流式二进制，
	// 支持 Range 续传，sha256 在响应头 X-Package-Sha256）；上传为 partner multipart。
	@handler LatestVersionHandler
	get /games/:id/versions/latest (IdPathRequest) returns (LatestVersionResponse)

	@handler DownloadVersionHandler
	get /games/:id/versions/:versionId/download (VersionPathRequest)

	@handler PartnerUploadPackageHandler
	post /partner/games/:id/versions/:versionId/package (VersionPathRequest)
}


