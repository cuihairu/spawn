syntax = "v1"

// 基础请求类型
type Request {
	Name string `path:"name,options=you|me"`
}

type Response {
	Message string `json:"message"`
}

// 用户相关类型
type RegisterRequest {
	Username string `json:"username"`
	Email    string `json:"email"`
	Password string `json:"password"`
	Nickname string `json:"nickname,optional"`
}

type LoginRequest {
	Username string `json:"username"`
	Password string `json:"password"`
}

type UserInfoResponse {
	Id       int64  `json:"id"`
	Username string `json:"username"`
	Email    string `json:"email"`
	Nickname string `json:"nickname"`
}

type GetUserInfoRequest {
	Id int64 `path:"id"`
}

type UpdateUserInfoRequest {
	Id       int64  `path:"id"`
	Email    string `json:"email"`
	Nickname string `json:"nickname"`
}

type GameRecommendation {
	Id         string   `json:"id"`
	Title      string   `json:"title"`
	CoverImage string   `json:"cover_image"`
	Genres     []string `json:"genres"`
	Platforms  []string `json:"platforms"`
	Score      float64  `json:"score"`
	Tags       []string `json:"tags"`
}

type GetUserRecommendationsRequest {
	Id     int64  `path:"id"`
	Genres string `form:"genres,optional"`
	Limit  int64  `form:"limit,default=5"`
}

type LoginResponse {
	Token    string            `json:"token"`
	UserInfo *UserInfoResponse `json:"user_info"`
}

type ApiResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,optional"`
}

service user-api {
	// 原有测试接口
	@handler UserHandler
	get /from/:name (Request) returns (Response)

	// 用户认证接口
	@handler RegisterHandler
	post /auth/register (RegisterRequest) returns (ApiResponse)

	@handler LoginHandler
	post /auth/login (LoginRequest) returns (LoginResponse)

	// 用户信息接口
	@handler GetUserInfoHandler
	get /users/:id (GetUserInfoRequest) returns (ApiResponse)

	@handler UpdateUserInfoHandler
	put /users/:id (UpdateUserInfoRequest) returns (ApiResponse)

	// 游戏推荐接口
	@handler GetUserRecommendationsHandler
	get /users/:id/recommendations (GetUserRecommendationsRequest) returns (ApiResponse)
}
