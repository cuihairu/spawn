{
  "name": "spawn",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "overrides": {
      "decode-uri-component@>=0.2 <0.5": "0.5.1",
      "dompurify@<3.4.17": "3.4.17",
      "zod@<4.6.6": "4.6.6",
      "decode-uri-component@0.5.0": "0.5.1",
      "node-forge@<=1.4.2": "1.4.3",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "glob@>=9.0.0 <=14.0.1": "14.0.2",
      "vite@<6.4.5": "6.4.5"
    }
  },
  "scripts": {
    "mobile:typecheck": "pnpm --dir apps/mobile-app exec tsc --noEmit",
    "mobile:lint": "pnpm --dir apps/mobile-app exec eslint .",
    "web:typecheck": "pnpm --dir apps/web-client exec tsc -b",
    "web:lint": "pnpm --dir apps/web-client exec eslint .",
    "docs:dev": "pnpm --dir docs run dev",
    "docs:build": "pnpm --dir docs run build"
  }
}
