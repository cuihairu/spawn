# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Compiled service binaries (build outputs of `go build` in a module dir;
# one rule per service so the names stay explicit and never shadow source dirs)
/services/api-gateway/api-gateway
/services/community/community
/services/content-service/content-service
/services/courier-adapter/courier-adapter
/services/data-panel/data-panel
/services/game-catalog/game-catalog
/services/payments/payments
/services/promotions/promotions
/services/realtime-hub/realtime-hub
/services/user-service/user
/services/user-service/user-service
/services/user-service-rpc/user-service-rpc

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# JS workspace (pnpm hoisted 布局，根 node_modules)
node_modules/

# 服务本地运行时数据（game-catalog 默认 DSN file:data/games.db）
services/game-catalog/data/

# Expo 本地状态（误从仓根跑 expo CLI 时会生成在根目录）
.expo/

# Claude Code session settings
.claude/
