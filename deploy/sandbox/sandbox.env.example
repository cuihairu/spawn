# GP-005 联合沙箱环境变量样例（deploy/sandbox/sandbox.env.example）
#
# 用法：cp sandbox.env.example sandbox.env && docker compose --env-file sandbox.env up -d
# （或 export $(grep -v '^#' sandbox.env | xargs) 后 docker compose up -d。）
# sandbox.env 含密钥，勿提交仓库；本样例全部为开发/沙箱演示值。

# ---- 管理员引导（game-catalog）------------------------------------------------
# user-service 账号 id，逗号分隔；game-catalog 启动期幂等写为 platform_admin。
# 全新沙箱取 1 = 首个注册用户（谁先注册谁成为管理员——沙箱验收便利项）。
# 生产必须改为真实运营账号 id，或留空禁用引导。
ADMIN_USER_IDS=1

# ---- 令牌/密钥（演示值，生产必须全部覆盖）--------------------------------------
# 平台 JWT 签名密钥（user-service / 各校验方同值）。
JWT_SECRET=tappi-user-service-jwt-secret-key-2024
# realtime 服务间发布令牌（community ↔ realtime-hub）。
REALTIME_INTERNAL_TOKEN=tappi-realtime-internal-token-2024
# courier-adapter 代登录随机密码加密密钥。
CREDENTIAL_KEY=tappi-courier-adapter-credential-key-2026
# payments 沙箱渠道 HMAC 密钥（开发/沙箱专用；真实渠道不得使用）。
PAYMENTS_SANDBOX_SECRET=tappi-payments-sandbox-channel-secret-2026
# GP-203 发货 webhook 签名密钥（未配置 = 分发 fail-closed 全 403）。
# 沙箱联调发货时必须显式给值。
PAYMENTS_DELIVERY_SECRET=
# GP-302 payments → promotions 奖励评估签名密钥（两侧同值）。
PROMOTIONS_REWARD_SECRET=tappi-promotions-reward-secret-2026
# GP-307 payments ↔ courier-adapter 订单事实 S2S 查询令牌（两侧同值）。
# 沙箱联调售后工单归属校验时必须显式给值。
INTERNAL_TOKEN=

# ---- Courier 联运网关（外部冻结仓，croupier）----------------------------------
# 默认指向 compose 网络内的 courier-gateway:8080（需自行起 croupier 实例并接入
# 同一网络：docker network connect spawn_default <croupier容器> 或 compose 联合
# 编排）。未就绪时 courier-adapter/payments 可启动，游戏会话/下单端点以 502
# 呈现上游不可达——GP-005 沙箱以接口契约文档先行（见 README「Courier 接线」）。
COURIER_GATEWAY_URL=http://courier-gateway:8080
